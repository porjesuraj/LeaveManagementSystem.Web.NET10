@{
    ViewData["Title"] = "Home Page";
}

<div class="homepage-container">

    <section class="hero-section">
        <h1>Smart Leave Management, Made Simple</h1>
        <p class="hero-subtitle">
            Manage employee leaves effortlessly with a fast, secure, and user-friendly platform.
        </p>
    </section>

    <section class="intro-section">
        <p>
            Our Leave Management System streamlines leave requests, approvals, and tracking—helping
            organizations save time, reduce errors, and maintain transparency across teams.
        </p>
    </section>

    <section class="features-section">
        <h2>Key Features</h2>
        <ul class="features-list">
            <li>
                <strong>Easy Leave Requests</strong><br />
                Employees can apply for leaves in just a few clicks, with clear visibility of balances and policies.
            </li>
            <li>
                <strong>Quick Approvals</strong><br />
                Managers can review, approve, or reject leave requests instantly from a single dashboard.
            </li>
            <li>
                <strong>Real-Time Leave Tracking</strong><br />
                Track leave history, balances, and trends in real time—no spreadsheets required.
            </li>
            <li>
                <strong>Policy & Compliance Ready</strong><br />
                Configure leave types, rules, and holidays as per company policy.
            </li>
            <li>
                <strong>Secure & Reliable</strong><br />
                Built with security and performance in mind to protect sensitive employee data.
            </li>
        </ul>
    </section>

    <section class="audience-section">
        <h2>Designed for Modern Teams</h2>
        <p>
            Whether you’re a small business or a growing enterprise, this application adapts
            to your workflow and scales with your organization.
        </p>
        <ul class="highlights-list">
            <li>Simple UI</li>
            <li>Fast performance</li>
            <li>Role-based access</li>
            <li>Cloud-ready architecture</li>
        </ul>
    </section>

    <section class="cta-section">
        <h2>Get Started Today</h2>
        <p>
            Bring clarity and efficiency to your leave process with a system that works for everyone.
        </p>
    </section>

    <footer class="footer-section">
        <p>
            Designed &amp; Developed by <strong>Suraj Valu Porje</strong><br />
            Full Stack .NET Developer
        </p>
    </footer>

</div>
